<Project Sdk="Microsoft.NET.Sdk">
  <!-- openHUD's managed component: the entry OmsiLaunch's bridge loads inside OMSI. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>OpenHud</AssemblyName>
    <RootNamespace>OpenHud</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenHud.Core\OpenHud.Core.csproj" />
    <ProjectReference Include="..\OpenHud.Pause\OpenHud.Pause.csproj" />
    <ProjectReference Include="$(OmsiLaunchRoot)src\OmsiLaunch.Runtime.Modules\OmsiLaunch.Runtime.Modules.csproj" Private="false" />
    <ProjectReference Include="$(OmsiLaunchRoot)src\OmsiLaunch.Api\OmsiLaunch.Api.csproj" Private="false" />
    <InternalsVisibleTo Include="OpenHud.Tests" />
  </ItemGroup>
</Project>
